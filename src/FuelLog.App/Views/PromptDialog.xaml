<Window x:Class="FuelLog.App.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="LabelText" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBox x:Name="ValueBox" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="ОК" IsDefault="True" MinWidth="90" Style="{DynamicResource AccentButtonStyle}" Click="OnOk" />
            <Button Content="Отмена" IsCancel="True" MinWidth="90" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
