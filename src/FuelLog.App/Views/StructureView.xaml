<UserControl x:Class="FuelLog.App.Views.StructureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FuelLog.App.ViewModels">
    <UserControl.Resources>
        <Style x:Key="TreeCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StatRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="220" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ===== Дерево структуры ===== -->
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Структура" Style="{StaticResource SectionTitle}" />
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="+ Часть (рп)" Command="{Binding AddGroupCommand}" HorizontalAlignment="Stretch" Padding="6,6"
                        ToolTip="Добавить воинскую часть (рп)" />
                <Button Grid.Column="2" Content="+ Подразделение" Command="{Binding AddUnitCommand}" HorizontalAlignment="Stretch" Padding="6,6"
                        ToolTip="Добавить подразделение в выделенную воинскую часть" />
            </Grid>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="Выбрать все" Command="{Binding CheckAllCommand}" HorizontalAlignment="Stretch"
                            ToolTip="Отметить все подразделения всех воинских частей" />
                    <Button Grid.Column="2" Content="Снять все" Command="{Binding UncheckAllCommand}" HorizontalAlignment="Stretch"
                            ToolTip="Снять все отметки" />
                </Grid>
                <UniformGrid Rows="1">
                    <Button Command="{Binding RenameCommand}" HorizontalAlignment="Stretch" Margin="0,0,4,0" Padding="0,7"
                            ToolTip="Переименовать выделенное (F2)">
                        <TextBlock Text="&#xE8AC;" Style="{StaticResource Glyph}" FontSize="14" />
                    </Button>
                    <Button Command="{Binding MoveUpCommand}" HorizontalAlignment="Stretch" Margin="2,0" Padding="0,7" ToolTip="Переместить выше">
                        <TextBlock Text="&#xE74A;" Style="{StaticResource Glyph}" FontSize="14" />
                    </Button>
                    <Button Command="{Binding MoveDownCommand}" HorizontalAlignment="Stretch" Margin="2,0" Padding="0,7" ToolTip="Переместить ниже">
                        <TextBlock Text="&#xE74B;" Style="{StaticResource Glyph}" FontSize="14" />
                    </Button>
                    <Button Command="{Binding DeleteCommand}" HorizontalAlignment="Stretch" Margin="4,0,0,0" Padding="0,7"
                            ToolTip="Удалить выделенное (Delete)">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="14"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    </Button>
                </UniformGrid>
            </StackPanel>

            <Border Style="{StaticResource Card}" Padding="4">
                <TreeView ItemsSource="{Binding Nodes}" BorderThickness="0" Background="Transparent">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type vm:GroupNode}" ItemsSource="{Binding Units}">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Style="{StaticResource TreeCheck}"
                                          ToolTip="Отметить все подразделения воинской части" />
                                <TextBlock Text="{Binding Group.Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Units.Count, StringFormat={}  {0}}" Style="{StaticResource Hint}"
                                           VerticalAlignment="Center" FontSize="12" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                        <DataTemplate DataType="{x:Type vm:UnitNode}">
                            <StackPanel Orientation="Horizontal" Background="Transparent"
                                        ToolTip="Двойной щелчок — отметить только это подразделение">
                                <StackPanel.InputBindings>
                                    <MouseBinding Gesture="LeftDoubleClick"
                                                  Command="{Binding DataContext.CheckOnlyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" />
                                </StackPanel.InputBindings>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Style="{StaticResource TreeCheck}" />
                                <TextBlock Text="{Binding Unit.Name}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </TreeView.Resources>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="True" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.InputBindings>
                        <KeyBinding Key="F2" Command="{Binding RenameCommand}" />
                        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
                    </TreeView.InputBindings>
                </TreeView>
            </Border>
        </DockPanel>

        <!-- ===== Центральная часть: техника отмеченных подразделений ===== -->
        <DockPanel Grid.Column="2">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Command="{Binding TogglePanelCommand}" Padding="10,5" VerticalAlignment="Top">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="ToolTip" Value="Скрыть правую панель (сводка и добавление техники)" />
                            <Setter Property="Content">
                                <Setter.Value>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Скрыть панель" Margin="0,0,8,0" />
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE76C;" />
                                    </StackPanel>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPanelOpen}" Value="False">
                                    <Setter Property="ToolTip" Value="Показать правую панель (сводка и добавление техники)" />
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE76B;" Margin="0,0,8,0" />
                                                <TextBlock Text="Показать панель" />
                                            </StackPanel>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <StackPanel>
                    <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource SectionTitle}" Margin="0" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                Visibility="{Binding IsMultiChecked, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="Сводка:" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <RadioButton Content="по маркам" IsChecked="{Binding GroupByModels}" MinWidth="0" Margin="0,0,16,0" />
                        <RadioButton Content="по подразделениям" IsChecked="{Binding GroupByUnits}" MinWidth="0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <Grid>
                <!-- Ничего не отмечено -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding IsNothingChecked, Converter={StaticResource VisibleWhen}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                        <TextBlock Text="&#xE73A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="36"
                                   HorizontalAlignment="Center" Margin="0,0,0,12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Отметьте подразделения галочками" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource Hint}" TextAlignment="Center"
                                   Text="Одно подразделение — состав техники с правкой количества. Несколько или вся воинская часть — сводная таблица. Галочка у воинской части отмечает все её подразделения, двойной щелчок по названию — только это подразделение." />
                    </StackPanel>
                </Border>

                <!-- Одно подразделение: состав техники -->
                <DockPanel Visibility="{Binding IsSingleChecked, Converter={StaticResource VisibleWhen}}">
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="Количество можно изменить прямо в таблице. Баки и нормы расхода задаются в справочнике техники." />
                    <Grid>
                        <DataGrid ItemsSource="{Binding UnitRows}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Марка" Binding="{Binding Model.Name}" IsReadOnly="True" Width="*" MinWidth="140" />
                                <DataGridTextColumn Header="Топл." Binding="{Binding Model.FuelName}" IsReadOnly="True" Width="56" />
                                <DataGridTextColumn Header="Кол-во" Width="66"
                                                    Binding="{Binding Count, Converter={StaticResource InputNumber}, UpdateSourceTrigger=LostFocus}"
                                                    ElementStyle="{StaticResource RightCell}" EditingElementStyle="{StaticResource NumberEdit}" />
                                <DataGridTextColumn Header="Баки, л" Binding="{Binding TanksText, Mode=OneWay}" IsReadOnly="True" Width="96" ElementStyle="{StaticResource RightCell}" />
                                <DataGridTextColumn Header="л/100 км" Binding="{Binding Model.LitersPer100Km, StringFormat=0.##}" IsReadOnly="True" Width="72" ElementStyle="{StaticResource RightCell}" />
                                <DataGridTextColumn Header="л/ч" Binding="{Binding Model.LitersPerHour, StringFormat=0.##}" IsReadOnly="True" Width="52" ElementStyle="{StaticResource RightCell}" />
                                <DataGridTextColumn Header="Заправка, кг" Binding="{Binding TotalKg, StringFormat=N0}" IsReadOnly="True" Width="96" ElementStyle="{StaticResource RightCell}" />
                                <DataGridTemplateColumn Width="46">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:UnitVehicleRow}">
                                            <Button Content="✕" ToolTip="Убрать из подразделения" Padding="6,0" MinHeight="0" Height="26"
                                                    Command="{Binding DataContext.RemoveVehicleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" TextAlignment="Center"
                                   Text="За подразделением пока не закреплена техника. Добавьте её в правой панели."
                                   Visibility="{Binding UnitRows.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                    </Grid>
                </DockPanel>

                <!-- Несколько подразделений: сводная таблица по маркам -->
                <DataGrid ItemsSource="{Binding ModelRows}" IsReadOnly="True">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMultiChecked}" Value="True" />
                                        <Condition Binding="{Binding GroupByUnits}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Марка" Binding="{Binding Model.Name}" Width="*" MinWidth="140" />
                        <DataGridTextColumn Header="Топл." Binding="{Binding Model.FuelName}" Width="56" />
                        <DataGridTextColumn Header="Всего, ед." Binding="{Binding Count}" Width="72" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="Баки 1 ед., л" Binding="{Binding TanksText, Mode=OneWay}" Width="96" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="Объём всего, л" Binding="{Binding TotalLiters, StringFormat=N0}" Width="92" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="Заправка, кг" Binding="{Binding TotalKg, StringFormat=N0}" Width="96" ElementStyle="{StaticResource RightCell}" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Несколько подразделений: сводная таблица по подразделениям -->
                <DataGrid ItemsSource="{Binding UnitSummaryRows}" IsReadOnly="True">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMultiChecked}" Value="True" />
                                        <Condition Binding="{Binding GroupByUnits}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Воинская часть" Binding="{Binding Group.Name}" Width="*" MinWidth="90" />
                        <DataGridTextColumn Header="Подразделение" Binding="{Binding Unit.Name}" Width="*" MinWidth="120" />
                        <DataGridTextColumn Header="Техники, ед." Binding="{Binding Figures.Vehicles}" Width="76" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="Баки АБ, л" Binding="{Binding Figures.Liters.Petrol, StringFormat=N0}" Width="84" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="Баки ДТ, л" Binding="{Binding Figures.Liters.Diesel, StringFormat=N0}" Width="84" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="Заправка АБ, кг" Binding="{Binding Figures.Kg.Petrol, StringFormat=N0}" Width="96" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="Заправка ДТ, кг" Binding="{Binding Figures.Kg.Diesel, StringFormat=N0}" Width="96" ElementStyle="{StaticResource RightCell}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </DockPanel>

        <!-- ===== Правая панель: сводка и добавление техники ===== -->
        <ScrollViewer Grid.Column="3" Width="260" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsPanelOpen, Converter={StaticResource VisibleWhen}}">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Сводка" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SummaryCaption}" Style="{StaticResource Hint}" FontSize="12" Margin="0,0,0,12" />

                        <Grid Style="{StaticResource StatRow}">
                            <StackPanel>
                                <TextBlock Text="Техники, ед." Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding Summary.Vehicles}" Style="{StaticResource StatValue}" />
                                <TextBlock Style="{StaticResource Hint}" FontSize="12">
                                    <Run Text="АБ:" /> <Run Text="{Binding Summary.PetrolVehicles, Mode=OneWay}" />
                                    <Run Text="   ДТ:" /> <Run Text="{Binding Summary.DieselVehicles, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource StatRow}">
                            <StackPanel>
                                <TextBlock Text="Масса заправки АБ" Style="{StaticResource FieldLabel}" />
                                <TextBlock Style="{StaticResource StatValue}">
                                    <Run Text="{Binding Summary.Kg.Petrol, Mode=OneWay, StringFormat=N0}" /><Run Text=" кг" FontSize="14" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Hint}" FontSize="12" Text="{Binding Summary.Liters.Petrol, StringFormat='объём баков {0:N0} л'}" />
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource StatRow}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="Масса заправки ДТ" Style="{StaticResource FieldLabel}" />
                                <TextBlock Style="{StaticResource StatValue}">
                                    <Run Text="{Binding Summary.Kg.Diesel, Mode=OneWay, StringFormat=N0}" /><Run Text=" кг" FontSize="14" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Hint}" FontSize="12" Text="{Binding Summary.Liters.Diesel, StringFormat='объём баков {0:N0} л'}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Добавить технику" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding AddTargetText}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanAddToChecked}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="Марка из справочника" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Catalog}" SelectedItem="{Binding AddModel}"
                                  IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                                  DisplayMemberPath="Name" Margin="0,0,0,10" />
                        <TextBlock Text="Количество" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding AddCount, Converter={StaticResource InputNumber}, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource NumberEdit}" Margin="0,0,0,12" />
                        <Button Content="Добавить" Command="{Binding AddVehicleCommand}" Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch" Padding="12,7" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
