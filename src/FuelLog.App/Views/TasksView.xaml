<UserControl x:Class="FuelLog.App.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FuelLog.App.ViewModels"
             xmlns:model="clr-namespace:FuelLog.Core.Model;assembly=FuelLog.Core">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" MinWidth="240" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Список задач ===== -->
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Задачи" Style="{StaticResource SectionTitle}" />
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="+ Задача" Command="{Binding AddTaskCommand}" Style="{StaticResource AccentButtonStyle}" Padding="12,6" Margin="0,0,6,0"
                        ToolTip="Создать новую задачу" />
                <Button Content="Копия" Command="{Binding DuplicateTaskCommand}" Style="{StaticResource ToolButton}" Margin="0,0,6,0"
                        ToolTip="Создать копию выбранной задачи вместе с составом техники" />
                <Button Content="Удалить" Command="{Binding DeleteTaskCommand}" Style="{StaticResource DangerButton}" Margin="0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <TextBlock Text="{Binding TasksSummary}" Style="{StaticResource Hint}" FontSize="12" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Отметить все" Command="{Binding IncludeAllCommand}" Padding="8,4" Margin="0,0,4,0" FontSize="12"
                            ToolTip="Включить все задачи в расчёт" />
                    <Button Content="Снять все" Command="{Binding ExcludeAllCommand}" Padding="8,4" FontSize="12"
                            ToolTip="Исключить все задачи из расчёта" />
                </StackPanel>
            </StackPanel>

            <Border Style="{StaticResource Card}" Padding="4">
                <Grid>
                    <ListBox ItemsSource="{Binding TasksView}" SelectedItem="{Binding SelectedTask}"
                             BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.InputBindings>
                            <KeyBinding Key="Delete" Command="{Binding DeleteTaskCommand}" />
                        </ListBox.InputBindings>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type model:FuelTask}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsIncluded}" VerticalAlignment="Center" MinWidth="0" Margin="0,0,6,0"
                                              ToolTip="Учитывать задачу в отчёте" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Hint}" FontSize="12">
                                            <Run Text="{Binding Date, Mode=OneWay, Converter={StaticResource DateOnly}, StringFormat=dd.MM.yyyy}" />
                                            <Run Text=" · строк техники:" /> <Run Text="{Binding Items.Count, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" VerticalAlignment="Center" Margin="16"
                               Text="Задач пока нет. Нажмите «Новая задача»."
                               Visibility="{Binding Project.Tasks.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                </Grid>
            </Border>
        </DockPanel>

        <!-- ===== Редактор задачи ===== -->
        <Border Grid.Column="2" Style="{StaticResource Card}"
                Visibility="{Binding HasTask, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
            <TextBlock Text="Выберите задачу слева или создайте новую." Style="{StaticResource Hint}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <DockPanel Grid.Column="2" Visibility="{Binding HasTask, Converter={StaticResource VisibleWhen}}">

            <!-- Реквизиты задачи -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12" DataContext="{Binding SelectedTask}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Выполняемая задача (как в отчёте)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Тип задачи" Style="{StaticResource FieldLabel}" />
                    <ComboBox IsEditable="True"
                              ItemsSource="{Binding DataContext.TaskTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              Text="{Binding TaskType, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Дата выполнения" Style="{StaticResource FieldLabel}" />
                    <DatePicker SelectedDate="{Binding Date, Converter={StaticResource DateOnly}}" SelectedDateFormat="Short" />
                </StackPanel>
            </Grid>

            <!-- Итоги задачи -->
            <UniformGrid DockPanel.Dock="Top" Rows="1" Margin="0,0,0,12">
                <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Техники, ед." Style="{StaticResource FieldLabel}" />
                        <TextBlock Style="{StaticResource StatValue}">
                            <Run Text="{Binding Totals.Vehicles, Mode=OneWay}" />
                            <Run Text="{Binding Totals.Lost, Mode=OneWay, StringFormat=(потери: {0})}" FontSize="13" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Расход АБ" Style="{StaticResource FieldLabel}" />
                        <TextBlock Style="{StaticResource StatValue}">
                            <Run Text="{Binding Totals.PetrolKg, Mode=OneWay, StringFormat=N2}" /><Run Text=" кг" FontSize="13" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Расход ДТ" Style="{StaticResource FieldLabel}" />
                        <TextBlock Style="{StaticResource StatValue}">
                            <Run Text="{Binding Totals.DieselKg, Mode=OneWay, StringFormat=N2}" /><Run Text=" кг" FontSize="13" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Padding="12" CornerRadius="8" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Totals.Problems}" Value="0">
                                    <Setter Property="Opacity" Value="0.55" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Проблемные строки" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding Totals.Problems}" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Добавление техники -->
            <Expander DockPanel.Dock="Bottom" IsExpanded="True" Margin="0,12,0,0" Header="Добавить технику в задачу">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Top" ItemsSource="{Binding UnitChoices}" SelectedItem="{Binding PickUnit}"
                                  DisplayMemberPath="Display" Margin="0,0,0,8" />
                        <Grid>
                            <DataGrid ItemsSource="{Binding PickRows}" Height="170">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Марка" Binding="{Binding Model.Name}" IsReadOnly="True" Width="*" MinWidth="140" />
                                    <DataGridTextColumn Header="Топливо" Binding="{Binding Model.FuelName}" IsReadOnly="True" Width="75" />
                                    <DataGridTextColumn Header="В наличии" Binding="{Binding Available}" IsReadOnly="True" Width="90" ElementStyle="{StaticResource RightCell}" />
                                    <DataGridTextColumn Header="Добавить" Width="90"
                                                        Binding="{Binding Count, Converter={StaticResource InputNumber}}"
                                                        ElementStyle="{StaticResource RightCell}" EditingElementStyle="{StaticResource NumberEdit}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"
                                       Text="Выберите подразделение — здесь появится закреплённая за ним техника."
                                       Visibility="{Binding PickRows.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                        </Grid>
                    </DockPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Значения для новых строк" Style="{StaticResource FieldLabel}" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Марш, км" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Style="{StaticResource NumberEdit}"
                                     Text="{Binding DefaultDistanceKm, Converter={StaticResource InputNumber}}" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Работа на месте, ч" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Style="{StaticResource NumberEdit}"
                                     Text="{Binding DefaultWorkHours, Converter={StaticResource InputNumber}}" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Потери, %" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Style="{StaticResource NumberEdit}"
                                     Text="{Binding DefaultLossPercent, Converter={StaticResource InputNumber}}" />
                        </Grid>
                        <Button Content="Добавить отмеченное" Command="{Binding AddPickedCommand}" Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,6" ToolTip="Добавить технику с количеством в колонке «Добавить»" />
                        <Button Content="Добавить всё подразделение" Command="{Binding AddWholeUnitCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                        <Button Content="Применить ко всем строкам задачи" Command="{Binding ApplyDefaultsToAllCommand}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>
            </Expander>

            <!-- Состав задачи -->
            <Grid>
                <DataGrid ItemsSource="{Binding ItemRows}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOverAvailable}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    <Setter Property="ToolTip" Value="Задействовано больше, чем закреплено за подразделением" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBroken}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    <Setter Property="ToolTip" Value="Подразделение или марка удалены — строка не попадёт в отчёт" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Подразделение" Binding="{Binding UnitName, Mode=OneWay}" IsReadOnly="True" Width="1.2*" MinWidth="150" />
                        <DataGridTextColumn Header="Марка" Binding="{Binding ModelName, Mode=OneWay}" IsReadOnly="True" Width="*" MinWidth="120" />
                        <DataGridTextColumn Header="Топл." Binding="{Binding FuelName, Mode=OneWay}" IsReadOnly="True" Width="56" />
                        <DataGridTextColumn Header="Кол-во" Width="64"
                                            Binding="{Binding Count, Converter={StaticResource InputNumber}}"
                                            ElementStyle="{StaticResource RightCell}" EditingElementStyle="{StaticResource NumberEdit}" />
                        <DataGridTextColumn Header="Есть" Binding="{Binding Available, Mode=OneWay}" IsReadOnly="True" Width="60" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="Марш, км" Width="70"
                                            Binding="{Binding DistanceKm, Converter={StaticResource InputNumber}}"
                                            ElementStyle="{StaticResource RightCell}" EditingElementStyle="{StaticResource NumberEdit}" />
                        <DataGridTextColumn Header="Работа, ч" Width="70"
                                            Binding="{Binding WorkHours, Converter={StaticResource InputNumber}}"
                                            ElementStyle="{StaticResource RightCell}" EditingElementStyle="{StaticResource NumberEdit}" />
                        <DataGridTextColumn Header="Потери, %" Width="70"
                                            Binding="{Binding LossPercent, Converter={StaticResource InputNumber}}"
                                            ElementStyle="{StaticResource RightCell}" EditingElementStyle="{StaticResource NumberEdit}" />
                        <DataGridTextColumn Header="Потери, ед." Binding="{Binding LostCount, Mode=OneWay}" IsReadOnly="True" Width="70" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="Расход, кг" Binding="{Binding Kg, Mode=OneWay, Converter={StaticResource Number}, ConverterParameter=N2}" IsReadOnly="True" Width="90" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTemplateColumn Width="48">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:TaskItemRow}">
                                    <Button Content="✕" ToolTip="Убрать строку из задачи" Padding="6,0" MinHeight="0" Height="26"
                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" TextAlignment="Center"
                           Text="В задаче пока нет техники. Выберите подразделение в панели ниже, укажите количество и нажмите «Добавить отмеченное»."
                           Visibility="{Binding ItemRows.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
