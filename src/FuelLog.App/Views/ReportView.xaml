<UserControl x:Class="FuelLog.App.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FuelLog.App.ViewModels">
    <UserControl.Resources>
        <Style x:Key="PreviewCell" TargetType="TextBlock" BasedOn="{StaticResource RightCell}" />
        <Style x:Key="WrapCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,4" />
        </Style>
    </UserControl.Resources>

    <TabControl Padding="0,12,0,0" Background="Transparent" BorderThickness="0">
        <!-- ===== Предпросмотр ===== -->
        <TabItem Header="Предпросмотр">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="Сформировать Excel" Command="{Binding ExportCommand}"
                        Style="{StaticResource AccentButtonStyle}" Padding="16,8" VerticalAlignment="Top" />
                <StackPanel>
                    <TextBlock Text="Расчёт расхода ГСМ" Style="{StaticResource SectionTitle}" Margin="0" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Таблица повторяет лист «Расчёт» в Excel. В файл также попадают детализация по маркам и параметры расчёта." />
                </StackPanel>
            </DockPanel>

            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <CheckBox Content="Только задачи, отмеченные «в расчёт»" IsChecked="{Binding OnlyIncluded}" Margin="0,0,24,0" />
                <CheckBox Content="За период" IsChecked="{Binding UseDateRange}" Margin="0,0,8,0" />
                <StackPanel Orientation="Horizontal" IsEnabled="{Binding UseDateRange}">
                    <TextBlock Text="с" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <DatePicker SelectedDate="{Binding From}" Width="140" />
                    <TextBlock Text="по" VerticalAlignment="Center" Margin="10,0,6,0" />
                    <DatePicker SelectedDate="{Binding To}" Width="140" />
                </StackPanel>
            </WrapPanel>

            <!-- Предупреждения -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="12" CornerRadius="8"
                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                    Visibility="{Binding Warnings.Count, Converter={StaticResource VisibleWhen}}">
                <StackPanel>
                    <TextBlock Text="Проверьте данные" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Warnings}" MaxHeight="110">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid>
                <DataGrid ItemsSource="{Binding Rows}" IsReadOnly="True" CanUserSortColumns="False" RowHeight="NaN" MinRowHeight="30"
                         >
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PreviewRowKind.GroupTotal}">
                                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PreviewRowKind.GrandTotal}">
                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDisabledBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Воинская часть" Binding="{Binding GroupName}" Width="1.1*" MinWidth="130" ElementStyle="{StaticResource WrapCell}" />
                        <DataGridTextColumn Header="Подразделение" Binding="{Binding UnitName}" Width="*" MinWidth="100" ElementStyle="{StaticResource WrapCell}" />
                        <DataGridTextColumn Header="Задача" Binding="{Binding TaskName}" Width="1.6*" MinWidth="160" ElementStyle="{StaticResource WrapCell}" />
                        <DataGridTextColumn Header="Дата" Binding="{Binding DateLabel}" Width="100" ElementStyle="{StaticResource WrapCell}" />
                        <DataGridTextColumn Header="АБ, кг" Binding="{Binding Figures.Kg.Petrol, Converter={StaticResource Number}}" Width="82" ElementStyle="{StaticResource PreviewCell}" />
                        <DataGridTextColumn Header="АБ, запр" Binding="{Binding Figures.Refills.Petrol, Converter={StaticResource Number}}" Width="68" ElementStyle="{StaticResource PreviewCell}" />
                        <DataGridTextColumn Header="ДТ, кг" Binding="{Binding Figures.Kg.Diesel, Converter={StaticResource Number}}" Width="82" ElementStyle="{StaticResource PreviewCell}" />
                        <DataGridTextColumn Header="ДТ, запр" Binding="{Binding Figures.Refills.Diesel, Converter={StaticResource Number}}" Width="68" ElementStyle="{StaticResource PreviewCell}" />
                        <DataGridTextColumn Binding="{Binding Figures.Mass.Petrol, Converter={StaticResource Number}, ConverterParameter=N0}" Width="80" ElementStyle="{StaticResource PreviewCell}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Масса АБ, кг" TextWrapping="Wrap" ToolTip="Масса заправки АБ, кг" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Figures.Mass.Diesel, Converter={StaticResource Number}, ConverterParameter=N0}" Width="80" ElementStyle="{StaticResource PreviewCell}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Масса ДТ, кг" TextWrapping="Wrap" ToolTip="Масса заправки ДТ, кг" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Figures.DailyRefills.Petrol, Converter={StaticResource Number}}" Width="68" ElementStyle="{StaticResource PreviewCell}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Сут. АБ, запр" TextWrapping="Wrap" ToolTip="Среднесуточный расход АБ, заправок" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Figures.DailyRefills.Diesel, Converter={StaticResource Number}}" Width="68" ElementStyle="{StaticResource PreviewCell}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Сут. ДТ, запр" TextWrapping="Wrap" ToolTip="Среднесуточный расход ДТ, заправок" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                            Visibility="{Binding Rows.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                    <TextBlock Text="Нет данных для расчёта" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Hint}" TextAlignment="Center"
                               Text="Создайте задачи на вкладке «Задачи», добавьте в них технику и отметьте их для расчёта." />
                </StackPanel>
            </Grid>
        </DockPanel>
        </TabItem>

        <!-- ===== Сформированные отчёты ===== -->
        <TabItem>
            <TabItem.Header>
                <TextBlock>
                    <Run Text="Сформированные отчёты" /> <Run Text="{Binding Files.Count, Mode=OneWay, StringFormat=({0})}" />
                </TextBlock>
            </TabItem.Header>
        <DockPanel MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Открыть папку отчётов" Command="{Binding OpenReportsFolderCommand}" Style="{StaticResource ToolButton}" />
                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                           Text="Отчёты сохраняются в папку «Отчёты» рядом с файлом проекта." />
            </StackPanel>
            <Border Style="{StaticResource Card}" Padding="4">
                <Grid>
                    <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" BorderThickness="0"
                             Background="Transparent" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ReportFile}">
                                <DockPanel Margin="0,2">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Открыть" Padding="10,4" Margin="0,0,4,0"
                                                Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Content="В папке" Padding="10,4" Margin="0,0,4,0"
                                                Command="{Binding DataContext.ShowFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Content="Удалить" Padding="10,4"
                                                Command="{Binding DataContext.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                        <TextBlock Style="{StaticResource Hint}" FontSize="12">
                                            <Run Text="{Binding Created, Mode=OneWay, StringFormat=dd.MM.yyyy HH:mm}" />
                                            <Run Text=" · " /><Run Text="{Binding SizeText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" VerticalAlignment="Center" Margin="16"
                               Text="Отчёты ещё не формировались. Файлы сохраняются в папку «Отчёты» рядом с проектом."
                               Visibility="{Binding Files.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                </Grid>
            </Border>
        </DockPanel>
        </TabItem>
    </TabControl>
</UserControl>
