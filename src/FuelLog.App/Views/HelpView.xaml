<UserControl x:Class="FuelLog.App.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Заголовок раздела со значком -->
        <Style x:Key="SectionIcon" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Section" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,36,0,0" />
        </Style>
        <Style x:Key="P" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="21" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource P}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <!-- Пункт списка с маркером-точкой -->
        <Style x:Key="Bullet" TargetType="ContentControl">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,8,0,0" />
                            <ContentPresenter Grid.Column="1" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Формула: моноширинный шрифт и цветная полоса слева -->
        <Style x:Key="Formula" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Courier New" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- Номер шага -->
        <Style x:Key="StepBadge" TargetType="Border">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="StepNumber" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <!-- Клавиша -->
        <Style x:Key="Key" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="MinWidth" Value="28" />
        </Style>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <!-- Пункт оглавления -->
        <Style x:Key="TocLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Оглавление ===== -->
        <Border Style="{StaticResource Card}" Padding="8,12" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="СОДЕРЖАНИЕ" FontSize="11" FontWeight="SemiBold" Margin="10,0,0,8"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Button Style="{StaticResource TocLink}" Content="Быстрый старт" Tag="SecStart" Click="OnTocClick" />
                <Button Style="{StaticResource TocLink}" Content="Справочник техники" Tag="SecCatalog" Click="OnTocClick" />
                <Button Style="{StaticResource TocLink}" Content="Структура и техника" Tag="SecStructure" Click="OnTocClick" />
                <Button Style="{StaticResource TocLink}" Content="Задачи" Tag="SecTasks" Click="OnTocClick" />
                <Button Style="{StaticResource TocLink}" Content="Расчёт и отчёт" Tag="SecReport" Click="OnTocClick" />
                <Button Style="{StaticResource TocLink}" Content="Методика расчёта" Tag="SecMethod" Click="OnTocClick" />
                <Button Style="{StaticResource TocLink}" Content="Пример на цифрах" Tag="SecExample" Click="OnTocClick" />
                <Button Style="{StaticResource TocLink}" Content="Хранение данных" Tag="SecData" Click="OnTocClick" />
                <Button Style="{StaticResource TocLink}" Content="Клавиши" Tag="SecKeys" Click="OnTocClick" />
            </StackPanel>
        </Border>

        <!-- ===== Содержимое ===== -->
        <ScrollViewer x:Name="Scroller" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900" HorizontalAlignment="Left" Margin="0,0,16,32">

                <!-- Шапка -->
                <Border CornerRadius="12" Padding="28,24">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="{DynamicResource {x:Static SystemColors.AccentColorDark3Key}}" />
                            <GradientStop Offset="1" Color="{DynamicResource {x:Static SystemColors.AccentColorDark1Key}}" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="14" Background="#26FFFFFF" Margin="0,0,18,0">
                            <TextBlock Text="&#xE897;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Руководство пользователя" FontSize="24" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="FuelLog — учёт техники и расчёт расхода ГСМ. Всё основное — за пять минут чтения."
                                       Foreground="#E6FFFFFF" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Быстрый старт -->
                <StackPanel x:Name="SecStart" Style="{StaticResource Section}" Margin="0,28,0,0">
                    <DockPanel Margin="0,0,0,14">
                        <Border Style="{StaticResource SectionIcon}"><TextBlock Text="&#xE7C1;" Style="{StaticResource Glyph}" /></Border>
                        <TextBlock Text="Быстрый старт" Style="{StaticResource H}" />
                    </DockPanel>
                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource Card}" Margin="0,0,8,8">
                            <StackPanel>
                                <Border Style="{StaticResource StepBadge}"><TextBlock Text="1" Style="{StaticResource StepNumber}" /></Border>
                                <TextBlock Text="Заполните справочник техники" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0"
                                           Text="Марки, вид топлива, объём баков и нормы расхода. Готовый справочник можно загрузить из файла." />
                                <Border Style="{StaticResource Chip}"><TextBlock Text="Справочник техники" FontSize="12" /></Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="8,0,0,8">
                            <StackPanel>
                                <Border Style="{StaticResource StepBadge}"><TextBlock Text="2" Style="{StaticResource StepNumber}" /></Border>
                                <TextBlock Text="Опишите структуру" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0"
                                           Text="Воинские части (рп) и их подразделения, за каждым подразделением — техника с количеством." />
                                <Border Style="{StaticResource Chip}"><TextBlock Text="Структура и техника" FontSize="12" /></Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,8,8,0">
                            <StackPanel>
                                <Border Style="{StaticResource StepBadge}"><TextBlock Text="3" Style="{StaticResource StepNumber}" /></Border>
                                <TextBlock Text="Создайте задачи" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0"
                                           Text="Для каждой задачи — дата и техника подразделений: километры марша, часы работы, процент потерь." />
                                <Border Style="{StaticResource Chip}"><TextBlock Text="Задачи" FontSize="12" /></Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="8,8,0,0">
                            <StackPanel>
                                <Border Style="{StaticResource StepBadge}"><TextBlock Text="4" Style="{StaticResource StepNumber}" /></Border>
                                <TextBlock Text="Сформируйте отчёт" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0"
                                           Text="Проверьте предпросмотр и нажмите «Сформировать Excel» — файл откроется сразу." />
                                <Border Style="{StaticResource Chip}"><TextBlock Text="Расчёт и отчёт" FontSize="12" /></Border>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <Border Margin="0,12,0,0" Padding="14,10" CornerRadius="8" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE82F;" Style="{StaticResource Glyph}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Top" />
                            <TextBlock Style="{StaticResource P}" Margin="0"
                                       Text="Чтобы быстро разобраться, откройте пример со стартовой страницы («Закрыть проект» → «Открыть пример»): в нём уже есть техника, подразделения и задачи." />
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Справочник -->
                <StackPanel x:Name="SecCatalog" Style="{StaticResource Section}">
                    <DockPanel Margin="0,0,0,12">
                        <Border Style="{StaticResource SectionIcon}"><TextBlock Text="&#xE8F1;" Style="{StaticResource Glyph}" /></Border>
                        <TextBlock Text="Справочник техники" Style="{StaticResource H}" />
                    </DockPanel>
                    <ContentControl Style="{StaticResource Bullet}"><TextBlock Style="{StaticResource P}" Margin="0" Text="Ячейки правятся прямо в таблице: двойной щелчок или F2. Числа можно вводить и с запятой, и с точкой." /></ContentControl>
                    <ContentControl Style="{StaticResource Bullet}"><TextBlock Style="{StaticResource P}" Margin="0" Text="Изменение нормы или объёма бака сразу учитывается во всех подразделениях и задачах — копий параметров нет." /></ContentControl>
                    <ContentControl Style="{StaticResource Bullet}"><TextBlock Style="{StaticResource P}" Margin="0" Text="«Экспорт…» сохраняет справочник в файл для переноса на другой ПК, «Импорт…» загружает его (подходят и файлы FuelLog 3). Марки с совпадающим названием обновляются, новые — добавляются." /></ContentControl>
                </StackPanel>

                <!-- Структура -->
                <StackPanel x:Name="SecStructure" Style="{StaticResource Section}">
                    <DockPanel Margin="0,0,0,12">
                        <Border Style="{StaticResource SectionIcon}"><TextBlock Text="&#xE716;" Style="{StaticResource Glyph}" /></Border>
                        <TextBlock Text="Структура и техника" Style="{StaticResource H}" />
                    </DockPanel>
                    <ContentControl Style="{StaticResource Bullet}"><TextBlock Style="{StaticResource P}" Margin="0" Text="Галочками отмечаются подразделения, технику которых нужно показать. Галочка у воинской части отмечает все её подразделения, кнопки «Выбрать все» и «Снять все» — всю структуру." /></ContentControl>
                    <ContentControl Style="{StaticResource Bullet}"><TextBlock Style="{StaticResource P}" Margin="0" Text="Одно отмеченное подразделение — состав техники с правкой количества. Несколько — сводная таблица по маркам или по подразделениям." /></ContentControl>
                    <ContentControl Style="{StaticResource Bullet}"><TextBlock Style="{StaticResource P}" Margin="0" Text="Двойной щелчок по названию подразделения оставляет отмеченным только его. Технику добавляют в правой панели — при этом должно быть отмечено ровно одно подразделение." /></ContentControl>
                    <ContentControl Style="{StaticResource Bullet}"><TextBlock Style="{StaticResource P}" Margin="0" Text="Правую панель со сводкой можно скрыть кнопкой «Скрыть панель», чтобы таблице было просторнее." /></ContentControl>
                </StackPanel>

                <!-- Задачи -->
                <StackPanel x:Name="SecTasks" Style="{StaticResource Section}">
                    <DockPanel Margin="0,0,0,12">
                        <Border Style="{StaticResource SectionIcon}"><TextBlock Text="&#xE787;" Style="{StaticResource Glyph}" /></Border>
                        <TextBlock Text="Задачи" Style="{StaticResource H}" />
                    </DockPanel>
                    <ContentControl Style="{StaticResource Bullet}"><TextBlock Style="{StaticResource P}" Margin="0" Text="Название задачи попадает в отчёт как есть. По умолчанию оно совпадает с типом задачи, пока вы его не измените." /></ContentControl>
                    <ContentControl Style="{StaticResource Bullet}"><TextBlock Style="{StaticResource P}" Margin="0" Text="Технику добавляют из панели внизу: выберите подразделение, укажите количество в колонке «Добавить» и нажмите «Добавить отмеченное». Значения марша, работы и потерь задаются сразу для новых строк." /></ContentControl>
                    <ContentControl Style="{StaticResource Bullet}"><TextBlock Style="{StaticResource P}" Margin="0" Text="«Копия» создаёт такую же задачу со всей техникой — удобно для повторяющихся задач в разные дни." /></ContentControl>
                    <ContentControl Style="{StaticResource Bullet}"><TextBlock Style="{StaticResource P}" Margin="0" Text="Строки, где задействовано больше техники, чем закреплено за подразделением, подсвечиваются красным." /></ContentControl>
                </StackPanel>

                <!-- Отчёт -->
                <StackPanel x:Name="SecReport" Style="{StaticResource Section}">
                    <DockPanel Margin="0,0,0,12">
                        <Border Style="{StaticResource SectionIcon}"><TextBlock Text="&#xE9F9;" Style="{StaticResource Glyph}" /></Border>
                        <TextBlock Text="Расчёт и отчёт" Style="{StaticResource H}" />
                    </DockPanel>
                    <ContentControl Style="{StaticResource Bullet}"><TextBlock Style="{StaticResource P}" Margin="0" Text="В расчёт попадают задачи с галочкой в списке задач; можно дополнительно ограничить период." /></ContentControl>
                    <ContentControl Style="{StaticResource Bullet}"><TextBlock Style="{StaticResource P}" Margin="0" Text="Excel-файл содержит три листа: «Расчёт» — по установленной форме, «Детализация» — по каждой марке в каждой задаче, «Параметры» — плотности, методика и предупреждения." /></ContentControl>
                    <ContentControl Style="{StaticResource Bullet}"><TextBlock Style="{StaticResource P}" Margin="0" Text="Файлы сохраняются в папку «Отчёты» рядом с проектом; их список — на вкладке «Сформированные отчёты»." /></ContentControl>
                </StackPanel>

                <!-- Методика -->
                <StackPanel x:Name="SecMethod" Style="{StaticResource Section}">
                    <DockPanel Margin="0,0,0,12">
                        <Border Style="{StaticResource SectionIcon}"><TextBlock Text="&#xE8EF;" Style="{StaticResource Glyph}" /></Border>
                        <TextBlock Text="Методика расчёта" Style="{StaticResource H}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Muted}" Text="Расчёт ведётся по каждой строке задачи (марка техники одного подразделения), затем суммируется." />
                    <Border Style="{StaticResource Formula}"><TextBlock Style="{StaticResource Mono}" Text="Потеряно, ед. = кол-во × потери % / 100   (округление до целого, 0,5 — вверх)" /></Border>
                    <Border Style="{StaticResource Formula}"><TextBlock Style="{StaticResource Mono}" Text="Расход, л = работающие × (км / 100 × норма л/100 км + ч × норма л/ч) + потерянные × (бак осн. + бак доп.)" /></Border>
                    <Border Style="{StaticResource Formula}"><TextBlock Style="{StaticResource Mono}" Text="Расход, кг = расход, л × плотность (АБ или ДТ — в настройках проекта)" /></Border>
                    <Border Style="{StaticResource Formula}"><TextBlock Style="{StaticResource Mono}" Text="Масса заправки = Σ кол-во × (бак осн. + бак доп.) × плотность" /></Border>
                    <Border Style="{StaticResource Formula}"><TextBlock Style="{StaticResource Mono}" Text="Заправки = расход, кг / масса заправки" /></Border>
                    <Border Style="{StaticResource Formula}"><TextBlock Style="{StaticResource Mono}" Text="Среднесуточный расход = заправки / число дней выполнения задач" /></Border>
                    <Border Margin="0,4,0,0" Padding="14,10" CornerRadius="8" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Glyph}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Top"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            <TextBlock Style="{StaticResource P}" Margin="0"
                                       Text="Масса заправки берётся по ВСЕЙ технике уровня: для строки и итога подразделения — по подразделению, для итога воинской части — по всей части (включая подразделения без задач), для общего итога — сумма по воинским частям отчёта. Потерянные машины задачу не выполняют, а топливо из их баков списывается полностью." />
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Пример -->
                <StackPanel x:Name="SecExample" Style="{StaticResource Section}">
                    <DockPanel Margin="0,0,0,12">
                        <Border Style="{StaticResource SectionIcon}"><TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" /></Border>
                        <TextBlock Text="Пример на цифрах" Style="{StaticResource H}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Muted}"
                               Text="Из демонстрационного проекта: 2рп, 1 рдн, задача «Совершение марша». Плотность ДТ — 0,85 кг/л." />
                    <Border Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="16,9" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="Grid.ColumnSpan" Value="2" />
                                </Style>
                            </Grid.Resources>
                            <Border Grid.Row="0" /><Border Grid.Row="1" /><Border Grid.Row="2" /><Border Grid.Row="3" /><Border Grid.Row="4" /><Border Grid.Row="5" />

                            <TextBlock Grid.Row="0" Text="Исходные данные: МАЗ-543 × 6, марш 150 км, норма 125 л/100 км, бак 850 л, потери 17 %" />
                            <TextBlock Grid.Row="1" Text="Потеряно: 6 × 17 / 100 = 1,02 → 1 машина; работают 5" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="1 ед." FontWeight="SemiBold" />
                            <TextBlock Grid.Row="2" Text="Марш: 5 × 150 / 100 × 125" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="937,5 л" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="3" Text="Потери: 1 × 850 (полный бак списывается)" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="850,0 л" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="4" Text="Итого: 1 787,5 л × 0,85" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="1 519,38 кг" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="5" Text="Масса заправки 1 рдн (6 МАЗ по 850 л и 4 КамАЗ по 375 л): (5 100 + 1 500) × 0,85" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="5 610 кг" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="6" Text="Заправки: 1 519,38 / 5 610" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="0,27 запр" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Данные -->
                <StackPanel x:Name="SecData" Style="{StaticResource Section}">
                    <DockPanel Margin="0,0,0,12">
                        <Border Style="{StaticResource SectionIcon}"><TextBlock Text="&#xE74E;" Style="{StaticResource Glyph}" /></Border>
                        <TextBlock Text="Хранение данных" Style="{StaticResource H}" />
                    </DockPanel>
                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource Card}" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="Один файл проекта" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0" Text="Всё хранится в файле *.gsmproject (текст JSON). Сеть и база данных не нужны." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="8,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Автосохранение" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0" Text="Изменения записываются через секунду. Кнопка «Сохранить» не нужна, Ctrl+S сохраняет немедленно." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,8,8,0">
                            <StackPanel>
                                <TextBlock Text="Резервные копии" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0" Text="Последние 10 версий файла — в папке «Резервные копии» рядом с проектом." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="8,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Перенос и FuelLog 3" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0" Text="Для переноса скопируйте файл проекта. Проекты FuelLog 3 преобразуются при открытии, оригинал сохраняется как .v3.bak." />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>

                <!-- Клавиши -->
                <StackPanel x:Name="SecKeys" Style="{StaticResource Section}">
                    <DockPanel Margin="0,0,0,12">
                        <Border Style="{StaticResource SectionIcon}"><TextBlock Text="&#xE765;" Style="{StaticResource Glyph}" /></Border>
                        <TextBlock Text="Клавиши" Style="{StaticResource H}" />
                    </DockPanel>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" /><RowDefinition Height="34" /><RowDefinition Height="34" /><RowDefinition Height="34" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource Key}"><TextBlock Text="Ctrl" Style="{StaticResource KeyText}" /></Border>
                                <Border Style="{StaticResource Key}"><TextBlock Text="N" Style="{StaticResource KeyText}" /></Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Новый проект" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource Key}"><TextBlock Text="Ctrl" Style="{StaticResource KeyText}" /></Border>
                                <Border Style="{StaticResource Key}"><TextBlock Text="O" Style="{StaticResource KeyText}" /></Border>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Открыть проект" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource Key}"><TextBlock Text="Ctrl" Style="{StaticResource KeyText}" /></Border>
                                <Border Style="{StaticResource Key}"><TextBlock Text="S" Style="{StaticResource KeyText}" /></Border>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Сохранить немедленно" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource Key}"><TextBlock Text="F1" Style="{StaticResource KeyText}" /></Border>
                            </StackPanel>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Справка" VerticalAlignment="Center" />

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource Key}"><TextBlock Text="F2" Style="{StaticResource KeyText}" /></Border>
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="Правка ячейки, переименование" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource Key}"><TextBlock Text="Delete" Style="{StaticResource KeyText}" /></Border>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="Удалить выбранное" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource Key}"><TextBlock Text="Enter" Style="{StaticResource KeyText}" /></Border>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="Завершить правку ячейки" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource Key}"><TextBlock Text="Esc" Style="{StaticResource KeyText}" /></Border>
                            </StackPanel>
                            <TextBlock Grid.Row="3" Grid.Column="3" Text="Отменить правку ячейки" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

                <TextBlock Style="{StaticResource Hint}" Margin="0,28,0,0" HorizontalAlignment="Center"
                           Text="FuelLog 4 · © Ганжа А.А., ВА РВСН" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
