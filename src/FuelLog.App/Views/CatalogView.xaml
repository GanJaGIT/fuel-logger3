<UserControl x:Class="FuelLog.App.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Импорт…" Command="{Binding ImportCommand}" Style="{StaticResource ToolButton}"
                        ToolTip="Загрузить марки из файла *.gsmtemplate (в том числе из FuelLog 3)" />
                <Button Content="Экспорт…" Command="{Binding ExportCommand}" Style="{StaticResource ToolButton}" Margin="0"
                        ToolTip="Сохранить справочник в файл для переноса на другой ПК" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Справочник техники" Style="{StaticResource SectionTitle}" Margin="0" />
                <TextBlock Text="Марки, объём баков и нормы расхода. Изменения сразу учитываются во всех подразделениях и задачах."
                           Style="{StaticResource Hint}" />
            </StackPanel>
        </DockPanel>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="360" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                     ToolTip="Поиск по названию и примечанию" x:Name="SearchBox" />
            <TextBlock Text="Поиск марки…" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center"
                       Style="{StaticResource Hint}"
                       Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding CategoryFilter}" />
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button Content="+ Добавить марку" Command="{Binding AddCommand}" Style="{StaticResource AccentButtonStyle}" Padding="14,6" Margin="0,0,8,0" />
                <Button Content="Копировать" Command="{Binding DuplicateCommand}" Style="{StaticResource ToolButton}" />
                <Button Content="Удалить" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Margin="0" />
            </StackPanel>
        </Grid>

        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Style="{StaticResource Hint}">
            <Run Text="{Binding CountText, Mode=OneWay}" /><Run Text=". Двойной щелчок или F2 — правка ячейки; числа можно вводить с запятой или точкой." />
        </TextBlock>

        <Grid>
            <DataGrid x:Name="Grid" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}">
                <DataGrid.InputBindings>
                    <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Марка" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="2*" MinWidth="160" />
                    <DataGridComboBoxColumn Header="Топливо" Width="90"
                                            SelectedItemBinding="{Binding Fuel}">
                        <DataGridComboBoxColumn.ElementStyle>
                            <Style TargetType="ComboBox">
                                <Setter Property="ItemsSource" Value="{Binding DataContext.FuelTypes, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Setter Property="ItemTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource FuelName}}" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridComboBoxColumn.ElementStyle>
                        <DataGridComboBoxColumn.EditingElementStyle>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                <Setter Property="ItemsSource" Value="{Binding DataContext.FuelTypes, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Setter Property="ItemTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource FuelName}}" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridComboBoxColumn.EditingElementStyle>
                    </DataGridComboBoxColumn>
                    <DataGridTextColumn Header="Бак осн., л" Width="100"
                                        Binding="{Binding MainTankLiters, Converter={StaticResource InputNumber}}"
                                        ElementStyle="{StaticResource RightCell}" EditingElementStyle="{StaticResource NumberEdit}" />
                    <DataGridTextColumn Header="Бак доп., л" Width="100"
                                        Binding="{Binding ExtraTankLiters, Converter={StaticResource InputNumber}}"
                                        ElementStyle="{StaticResource RightCell}" EditingElementStyle="{StaticResource NumberEdit}" />
                    <DataGridTextColumn Header="Расход, л/100 км" Width="130"
                                        Binding="{Binding LitersPer100Km, Converter={StaticResource InputNumber}}"
                                        ElementStyle="{StaticResource RightCell}" EditingElementStyle="{StaticResource NumberEdit}" />
                    <DataGridTextColumn Header="Расход, л/ч" Width="110"
                                        Binding="{Binding LitersPerHour, Converter={StaticResource InputNumber}}"
                                        ElementStyle="{StaticResource RightCell}" EditingElementStyle="{StaticResource NumberEdit}" />
                    <DataGridTemplateColumn Header="Категория" Width="140" SortMemberPath="Category">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Category}" VerticalAlignment="Center" Margin="4,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox IsEditable="True"
                                          ItemsSource="{Binding DataContext.Categories, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          Text="{Binding Category, UpdateSourceTrigger=LostFocus}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Примечание" Binding="{Binding Note, UpdateSourceTrigger=LostFocus}" Width="*" MinWidth="120" />
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                        Visibility="{Binding Project.Catalog.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                <TextBlock Text="Справочник пуст" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource Hint}" TextAlignment="Center"
                           Text="Добавьте марки техники кнопкой «Добавить марку» или загрузите готовый справочник через «Импорт…» (подходят файлы *.gsmtemplate из FuelLog 3)." />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
