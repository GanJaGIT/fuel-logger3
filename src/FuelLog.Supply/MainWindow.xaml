<Window x:Class="FuelLog.Supply.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FuelLog.Supply.ViewModels"
        xmlns:views="clr-namespace:FuelLog.Supply.Views"
        Title="{Binding Title}"
        Icon="/Assets/fuel.ico"
        Width="1400" Height="880" MinWidth="1100" MinHeight="660"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DayViewModel}">
            <views:DayView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StartBalancesViewModel}">
            <views:StartBalancesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StructureViewModel}">
            <views:StructureView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TransportViewModel}">
            <views:TransportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LinksViewModel}">
            <views:LinksView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HelpPage}">
            <views:HelpView />
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewDocumentCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenDocumentCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveNowCommand}" />
        <KeyBinding Key="F1" Command="{Binding ShowHelpCommand}" />
    </Window.InputBindings>

    <Grid>
        <!-- ===== Стартовая страница ===== -->
        <Grid Visibility="{Binding IsOpen, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="{DynamicResource {x:Static SystemColors.AccentColorDark3Key}}" />
                        <GradientStop Offset="1" Color="{DynamicResource {x:Static SystemColors.AccentColorDark1Key}}" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="40,48,40,32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <Border Width="72" Height="72" CornerRadius="18" Background="#26FFFFFF" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="34" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Потребность и автономность" FontSize="30" FontWeight="SemiBold" Foreground="White" Margin="0,20,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="Запасы ГСМ рд по суткам · модель 2 к FuelLog" FontSize="15" Foreground="#E6FFFFFF" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <Border Background="#26FFFFFF" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left" Margin="0,12,0,0">
                            <TextBlock Text="{Binding AppVersion, StringFormat=версия {0}}" Foreground="White" FontSize="12" />
                        </Border>
                    </StackPanel>

                    <ItemsControl Grid.Row="1" VerticalAlignment="Top" Margin="0,48,0,0" ItemsSource="{Binding Features}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0,0,0,18" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:Feature}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="17" Background="#26FFFFFF" VerticalAlignment="Top" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Text}" Foreground="#CCFFFFFF" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Grid.Row="2" Text="© Ганжа А.А., ВА РВСН" Foreground="#B3FFFFFF" FontSize="12" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="48,48,48,32" MaxWidth="880" HorizontalAlignment="Left">
                    <TextBlock Text="Начало работы" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,20"
                               Text="Документ ведётся по суткам и опирается на проекты FuelLog (модель 1): из них берутся техника подразделений и расход на выполнение задач." />

                    <UniformGrid Rows="1" Columns="3">
                        <Button Style="{StaticResource ActionTile}" Command="{Binding NewDocumentCommand}" Margin="0,0,12,0" ToolTip="Ctrl+N">
                            <StackPanel>
                                <Border Style="{StaticResource TileIcon}" Background="{DynamicResource AccentFillColorDefaultBrush}">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource TileGlyph}" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <TextBlock Text="Создать документ" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Сразу привяжите проект FuelLog — структура построится по нему" Style="{StaticResource Hint}" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionTile}" Command="{Binding OpenDocumentCommand}" Margin="0,0,12,0" ToolTip="Ctrl+O">
                            <StackPanel>
                                <Border Style="{StaticResource TileIcon}">
                                    <TextBlock Text="&#xE8E5;" Style="{StaticResource TileGlyph}" />
                                </Border>
                                <TextBlock Text="Открыть документ" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Файл *.gsmsupply" Style="{StaticResource Hint}" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionTile}" Command="{Binding OpenSampleCommand}">
                            <StackPanel>
                                <Border Style="{StaticResource TileIcon}">
                                    <TextBlock Text="&#xE82F;" Style="{StaticResource TileGlyph}" />
                                </Border>
                                <TextBlock Text="Открыть пример" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Пример рд вместе со связанным проектом FuelLog и тремя сутками" Style="{StaticResource Hint}" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <TextBlock Text="Последние документы" FontSize="18" FontWeight="SemiBold" Margin="0,36,0,10" />
                    <Border Style="{StaticResource Card}" Padding="24"
                            Visibility="{Binding RecentDocuments.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,14,0" />
                            <TextBlock Text="Здесь появятся документы, с которыми вы работали." Style="{StaticResource Hint}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding RecentDocuments}"
                                  Visibility="{Binding RecentDocuments.Count, Converter={StaticResource VisibleWhen}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RecentDocument}">
                                <Button Style="{StaticResource RecentRow}" Margin="0,0,0,6" ToolTip="{Binding Path}"
                                        Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Открыть"
                                                      Command="{Binding PlacementTarget.Tag.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Убрать из списка"
                                                      Command="{Binding PlacementTarget.Tag.ForgetRecentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource SubtleFillColorSecondaryBrush}" HorizontalAlignment="Left">
                                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Folder}" Style="{StaticResource Hint}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="файл не найден" FontSize="12" VerticalAlignment="Center" Margin="12,0"
                                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                   Visibility="{Binding Exists, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                                        <TextBlock Grid.Column="3" Text="{Binding LastOpened, StringFormat=dd.MM.yyyy HH:mm}"
                                                   Style="{StaticResource Hint}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== Открытый документ ===== -->
        <Grid Visibility="{Binding IsOpen, Converter={StaticResource VisibleWhen}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.RowSpan="2" Background="{DynamicResource LayerFillColorAltBrush}">
                <StackPanel DockPanel.Dock="Top" Margin="16,16,16,12">
                    <TextBlock Text="{Binding Session.Project.Name}" FontSize="16" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Session.FilePath}" />
                    <TextBlock Text="потребность и автономность" Style="{StaticResource Hint}" FontSize="12" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="12">
                    <Button Content="Папка документа" Command="{Binding ShowFolderCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                    <Button Content="Сохранить копию…" Command="{Binding SaveCopyCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                    <Button Content="Закрыть документ" Command="{Binding CloseDocumentCommand}" HorizontalAlignment="Stretch" />
                </StackPanel>

                <ListBox Margin="8,0" BorderThickness="0" Background="Transparent"
                         SelectedIndex="{Binding SelectedTab, Converter={StaticResource EnumIndex}}"
                         ItemContainerStyle="{StaticResource NavItem}">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE787;" />
                            <TextBlock Text="Сутки" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE7B8;" />
                            <TextBlock Text="Наличие запасов" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE716;" />
                            <TextBlock Text="Структура и нормы" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE804;" />
                            <TextBlock Text="Транспорт подвоза" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE71B;" />
                            <TextBlock Text="Модели 1 (FuelLog)" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE713;" />
                            <TextBlock Text="Настройки" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE897;" />
                            <TextBlock Text="Справка" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>

            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="20,16,20,8" Focusable="False" />

            <Border Grid.Row="1" Grid.Column="1" Padding="20,6" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Session.FilePath}" Style="{StaticResource Hint}"
                               FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="600" />
                    <TextBlock FontSize="12" Text="{Binding Session.SaveStatus}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Session.HasSaveError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
