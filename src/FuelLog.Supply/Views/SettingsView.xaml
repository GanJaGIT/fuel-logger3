<UserControl x:Class="FuelLog.Supply.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="Настройки" Style="{StaticResource SectionTitle}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Документ" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Text="Название" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Project.Name, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,12" />
                        <TextBlock Text="Файл" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding FilePath}" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                   Text="Изменения сохраняются автоматически; предыдущие версии файла — в папке «Резервные копии» (последние 10)." />
                        <Button Content="Открыть резервные копии" Command="{Binding ShowBackupsCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Плотность для транспорта подвоза" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="АБ, кг/л" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Style="{StaticResource NumberEdit}" Text="{Binding Settings.PetrolDensity, Converter={StaticResource InputNumber}}" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ДТ, кг/л" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Style="{StaticResource NumberEdit}" Text="{Binding Settings.DieselDensity, Converter={StaticResource InputNumber}}" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,16"
                                   Text="Переводит вместимость цистерн (л) в килограммы при загрузке запасов в транспорт. Масса заправки подразделений считается по плотностям из проектов FuelLog." />

                        <TextBlock Text="Оформление" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" Width="220" HorizontalAlignment="Left">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Как в Windows" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="Light">
                                                        <Setter Property="Text" Value="Светлая тема" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="Gray">
                                                        <Setter Property="Text" Value="Серая тема" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="Dark">
                                                        <Setter Property="Text" Value="Тёмная тема" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
