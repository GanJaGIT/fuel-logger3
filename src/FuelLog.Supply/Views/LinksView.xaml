<UserControl x:Class="FuelLog.Supply.Views.LinksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FuelLog.Supply.ViewModels">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Обновить" Command="{Binding ReloadCommand}" Style="{StaticResource ToolButton}" ToolTip="Перечитать проекты FuelLog" />
                <Button Content="Сопоставить структуру" Command="{Binding SyncCommand}" Style="{StaticResource ToolButton}"
                        ToolTip="Привязать подразделения документа к проектам FuelLog по названиям, добавить недостающие" />
                <Button Content="+ Привязать проект FuelLog…" Command="{Binding AddLinkCommand}" Style="{StaticResource AccentButtonStyle}" Padding="14,6" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Модели 1 — проекты FuelLog" Style="{StaticResource SectionTitle}" Margin="0" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Документ опирается на проекты FuelLog: из них берутся техника подразделений (масса заправки с учётом плотности) и расход на выполнение задач по датам. Можно привязать несколько проектов — например, по одному на каждую часть. Проекты только читаются; изменения в FuelLog подхватываются автоматически." />
            </StackPanel>
        </DockPanel>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource WarningPanel}" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource Glyph}" Margin="0,0,10,0" VerticalAlignment="Top" />
                <TextBlock Text="{Binding UnlinkedRowsText}" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LinkItem}">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="8" VerticalAlignment="Top" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="17" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                                    <Setter Property="Text" Value="&#xE8A5;" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOk}" Value="False">
                                                            <Setter Property="Text" Value="&#xE7BA;" />
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="{Binding FullPath}" Style="{StaticResource Hint}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="2" VerticalAlignment="Center" MaxWidth="330">
                                        <Button Content="Открыть в FuelLog" Padding="10,4" Margin="0,0,4,4"
                                                Command="{Binding DataContext.OpenInFuelLogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Content="В папке" Padding="10,4" Margin="0,0,4,4"
                                                Command="{Binding DataContext.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Content="Указать файл…" Padding="10,4" Margin="0,0,4,4" ToolTip="Если проект перенесли в другую папку"
                                                Command="{Binding DataContext.RelocateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Content="Отвязать" Padding="10,4" Margin="0,0,4,4" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                        Visibility="{Binding Items.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                <TextBlock Text="&#xE71B;" Style="{StaticResource Glyph}" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Проекты FuelLog не привязаны" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource Hint}" TextAlignment="Center"
                           Text="Нажмите «Привязать проект FuelLog…» и выберите файл *.gsmproject. После привязки программа предложит сопоставить структуру по названиям частей и подразделений." />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
